{
  "type": "object",
  "additionalProperties": false,
  "required": ["replicates", "item_observation"],
  "properties": {
    "replicates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["replicate", "a", "b", "comparisons", "rationale"],
        "properties": {
          "replicate": {"type": "integer", "minimum": 1, "maximum": 3},
          "a": {"$ref": "#/$defs/score"},
          "b": {"$ref": "#/$defs/score"},
          "comparisons": {
            "type": "object",
            "additionalProperties": false,
            "required": ["confusion_resolution", "boundary_precision", "transfer_support", "cognitive_efficiency", "overall"],
            "properties": {
              "confusion_resolution": {"$ref": "#/$defs/preference"},
              "boundary_precision": {"$ref": "#/$defs/preference"},
              "transfer_support": {"$ref": "#/$defs/preference"},
              "cognitive_efficiency": {"$ref": "#/$defs/preference"},
              "overall": {"$ref": "#/$defs/preference"}
            }
          },
          "rationale": {"type": "string"}
        }
      }
    },
    "item_observation": {"type": "string"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "forbidden"],
      "properties": {
        "facts": {"type": "array", "items": {"type": "boolean"}},
        "forbidden": {"type": "array", "items": {"type": "boolean"}}
      }
    },
    "preference": {
      "type": "string",
      "enum": ["A", "B", "tie"]
    }
  }
}
